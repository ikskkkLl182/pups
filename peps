-- FILL: if some drop is not picked up, add a piece of its real name to KEYWORDS.
local KEYWORDS = {"cash", "money", "coin", "dollar", "bill", "credit", "loot", "pickup", "drop", "currency", "gold"}
local BLACKLIST = {"billboard"}
local MAX_SIZE = 10

local candidates = {}

local function nameHas(n, list)
    n = string.lower(n)
    for _, k in ipairs(list) do
        if string.find(n, k, 1, true) then return true end
    end
    return false
end

local function chainMatches(inst)
    local p, depth = inst, 0
    while p and p ~= workspace and depth < 4 do
        if nameHas(p.Name, BLACKLIST) then return false end
        if nameHas(p.Name, KEYWORDS) then return true end
        p = p.Parent
        depth = depth + 1
    end
    return false
end

local function tooBig(inst)
    if inst:IsA("BasePart") then
        return inst.Size.Magnitude > MAX_SIZE
    end
    local ok, size = pcall(function() return inst:GetExtentsSize() end)
    return ok and size.Magnitude > MAX_SIZE
end

local function insideCharacter(inst)
    local p = inst.Parent
    while p and p ~= workspace do
        if p:FindFirstChildOfClass("Humanoid") then return true end
        p = p.Parent
    end
    return false
end

local function isCandidate(inst)
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then return false end
    if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then return false end
    if not chainMatches(inst) then return false end
    if tooBig(inst) then return false end
    if insideCharacter(inst) then return false end
    if inst:IsA("BasePart") then
        local par = inst.Parent
        if par and par ~= workspace and par:IsA("Model") and chainMatches(par) and not tooBig(par) then return false end
    end
    return true
end

local function partOf(inst)
    if inst:IsA("BasePart") then return inst end
    return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
end

local scanning, lastScan = false, 0
local function rescan()
    if scanning then return end
    scanning = true
    lastScan = os.clock()
    task.spawn(function()
        for k in pairs(candidates) do candidates[k] = nil end
        local n = 0
        for _, d in ipairs(workspace:GetDescendants()) do
            if isCandidate(d) then candidates[d] = true end
            n = n + 1
            if n % 1500 == 0 then task.wait() end
        end
        scanning = false
    end)
end

connect(workspace.DescendantAdded, function(d)
    if isCandidate(d) then candidates[d] = true end
end)

local pullList = {}

connect(RunService.Heartbeat, function()
    if not MONEY.enabled then
        if next(pullList) then pullList = {} end
        return
    end
    local chr = LocalPlayer.Character
    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local cf = hrp.CFrame
    for inst in pairs(pullList) do
        if inst.Parent then
            pcall(function()
                if inst:IsA("BasePart") then inst.CFrame = cf else inst:PivotTo(cf) end
            end)
        else
            pullList[inst] = nil
        end
    end
end)

local function cycle()
    local chr = LocalPlayer.Character
    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pos = hrp.Position
    local list = {}
    for inst in pairs(candidates) do
        if not inst.Parent then
            candidates[inst] = nil
        else
            local part = partOf(inst)
            if part and not tooBig(inst) and (part.Position - pos).Magnitude <= MONEY.range then
                list[inst] = true
            end
        end
    end
    pullList = list
end

local acc = 0
connect(RunService.Heartbeat, function(dt)
    if not MONEY.enabled then return end
    acc = acc + dt
    if acc >= MONEY.interval then
        acc = 0
        pcall(cycle)
    end
    if os.clock() - lastScan > 20 then rescan() end
end)

task.spawn(rescan)

