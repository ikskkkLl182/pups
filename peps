local function bgFind(name)
    name = name:gsub("^%s+", ""):gsub("%s+$", ""):gsub("\\", "/")
    local tries = {}
    if name:find("/", 1, true) then
        table.insert(tries, name)               -- full path inside workspace
    else
        table.insert(tries, BG_DIR .. "/" .. name)
    end
    local base = tries[1]
    for _, ext in ipairs({".png", ".jpg", ".jpeg"}) do table.insert(tries, base .. ext) end
    for _, p in ipairs(tries) do
        if isfile(p) then return p end
    end
    return nil
end

local function bgResolve(name)
    if name:match("^rbxassetid://") or name:match("^rbxasset://") then return name end
    assert(isfile and readfile and getcustomasset, "executor has no isfile/readfile/getcustomasset")
    local path = bgFind(name)
    assert(path, "file not found in workspace/" .. BG_DIR .. "/ : " .. name)
    local head = readfile(path):sub(1, 4)
    assert(head == "\137PNG" or head:sub(1, 3) == "\255\216\255",
        "not a real png/jpg (webp/gif/renamed file?) - convert it to png or jpg")
    return getcustomasset(path)
end

