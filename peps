-- Background: static image only.
-- No native WindUI background layer - draws into one plain ImageLabel we own outright,
-- no tween, no Window:SetBackgroundImage calls.
---------------------------------------------------------------------
local bgFallback -- our own ImageLabel, the only background surface that ever exists

local function ensureBgFallback()
    if bgFallback and bgFallback.Parent then return bgFallback end
    local main = Window.UIElements and Window.UIElements.Main
    assert(main, "no window frame")
    bgFallback = Instance.new("ImageLabel")
    bgFallback.Name = "WM_BG"
    bgFallback.BackgroundTransparency = 1
    bgFallback.Size = UDim2.fromScale(1, 1)
    bgFallback.ScaleType = Enum.ScaleType.Crop
    bgFallback.ZIndex = 0
    bgFallback.Active = false
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 16)
    c.Parent = bgFallback
    bgFallback.Parent = main
    return bgFallback
end

-- direct property write, no tween, used for both static apply and every gif frame
local function bgSet(asset)
    local fb = ensureBgFallback()
    fb.Image = asset
end

if initialBg then pcall(bgSet, initialBg) end -- restore last background now that the window exists

local function bgApply(name)
    if not name or name == "" then return end
    local ok, res = pcall(bgResolve, name)
    if not ok then
        WindUI:Notify({Title = "Background", Content = tostring(res)})
        return
    end
    local ok2, err = pcall(bgSet, res)
    if ok2 then
        pcall(function() if writefile then writefile(BG_LAST, name) end end)
        WindUI:Notify({Title = "Background", Content = "applied"})
    else
        WindUI:Notify({Title = "Background", Content = tostring(err)})
    end
end

