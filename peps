        local fb = ensureBgFallback()
        fb.ImageTransparency = v / 100
    end,
})

ConfigTab:Section({Title = "Session"})

ConfigTab:Button({
    Title = "Unload everything",
    Callback = function()
        if env.__WMCleanup then env.__WMCleanup() end
    end,
})

-- WindUI bug: Window:Close() hides the main frame but leaves any open dropdown's
-- floating menu (a separate top-level DropdownGui) on screen. Close it ourselves.
Window:OnClose(function()
    pcall(function()
        if AimTargetDropdown and AimTargetDropdown.Opened then
            AimTargetDropdown:Close()
        end
    end)
end)

---------------------------------------------------------------------
-- unload
---------------------------------------------------------------------
env.__WMCleanup = function()
    rowAlive = false
    AIM.enabled = false
    MONEY.enabled = false
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    pcall(function() fovGui:Destroy() end)
    pcall(function() Window:Destroy() end)
    env.__WMCleanup = nil
end

WindUI:Notify({Title = "war machines", Content = "menu loaded"})
