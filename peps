-- FILL: if War Machines renames the rig folder/part, fix these two lookups.
local function farmLowerTorso()
    local charactersFolder = Workspace:FindFirstChild("Characters")
    local rig = charactersFolder and charactersFolder:FindFirstChild(LocalPlayer.Name)
    return rig and rig:FindFirstChild("LowerTorso")
end

local function farmBurst()
    pcall(function()
        local gui = LocalPlayer.PlayerGui
        local sideBar = gui.Client and gui.Client:FindFirstChild("SideBar")
        local hotbar = gui:FindFirstChild("Hotbar")
        if not (sideBar and hotbar and sideBar.Visible and hotbar.Enabled) then return end

        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        task.wait(0.1)
        if not (sideBar.Visible and hotbar.Enabled) then return end

        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
        task.wait(0.0001)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
        task.wait(0.1)
        if not (sideBar.Visible and hotbar.Enabled) then return end

        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
        task.wait(0.0001)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    end)
end

local function farmLoop()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hrp then return end

    hrp.CFrame = CFrame.new(500, 700, 265)
    task.wait(0.1)
    farmBurst()

    local lowerTorso = farmLowerTorso()
    if not lowerTorso then return end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Parent = lowerTorso
    FARM.velocityObj = bv

    local loops, direction = 0, 1
    while FARM.running do
        loops = loops + 1
        if loops == 40 and FARM.bounce then
            direction = direction * -1
            loops = 0
        else
            bv.Velocity = Vector3.new(0, 1250 * direction, 0)
            task.wait(FARM.tweenTime)
        end
        bv.Velocity = Vector3.new(0, 100, 0)

        local overheat = char:GetAttribute("Overheat")
        if overheat ~= nil and FARM.autoCooldown and overheat >= 900 then
            repeat
                pcall(function() hrp.CFrame = CFrame.new(-830.82, 285, -509.22) end)
                farmBurst()
                task.wait(0.01)
            until (char:GetAttribute("Overheat") or 0) <= 50 or not FARM.running
        end

        farmBurst()
    end
end

local function farmStop()
    FARM.running = false
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if FARM.velocityObj then
        pcall(function() FARM.velocityObj.Velocity = Vector3.new(0, 0, 0) end)
    end
    if hrp then
        pcall(function()
            TweenService:Create(hrp, TweenInfo.new(FARM.tweenTime), {CFrame = CFrame.new(500, 700, 265)}):Play()
        end)
        task.wait(FARM.tweenTime)
    end
    if FARM.velocityObj then
        pcall(function() FARM.velocityObj:Destroy() end)
        FARM.velocityObj = nil
    end
    if hrp then
        pcall(function() hrp.Velocity = Vector3.new(0, -10, 0) end)
        task.wait(0.25)
        pcall(function() hrp.CFrame = CFrame.new(500, 640, 265) end)
    end
end

local function farmSet(v)
    if v then
        if FARM.running then return end
        FARM.running = true
        task.spawn(function()
            local ok, err = pcall(farmLoop)
            if not ok then
                warn("[farm] " .. tostring(err))
                FARM.running = false
            end
        end)
    else
        if not FARM.running and not FARM.velocityObj then return end
        task.spawn(farmStop)
    end
end

