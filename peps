-- Row / checkbox transparency + slider restyle.
-- WindUI draws rows as dark rounded sprites, so global transparency misses them.
-- We find them by color + size inside the WindUI gui and patch them directly.
-- Use Config -> "Scan UI (dump)" to see what was matched (copies a dump to clipboard).
---------------------------------------------------------------------
local ROW_ALPHA = 0.55      -- 0 = solid, 1 = invisible
local CHECK_FOLLOW = 0.6    -- checkboxes follow the row slider, scaled so they stay readable
local ACCENT = Color3.fromRGB(16, 137, 255)
local rowAlive = true

local rootCache
local function getRoot()
    if rootCache and rootCache.Parent then return rootCache end
    rootCache = nil
    local main = Window.UIElements and Window.UIElements.Main
    if main then
        rootCache = main:FindFirstAncestorOfClass("ScreenGui") or main
        return rootCache
    end
    -- fallback: find the gui that holds our "Aim enabled" row
    local holders = {}
    pcall(function() if gethui then table.insert(holders, gethui()) end end)
    table.insert(holders, game:GetService("CoreGui"))
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then table.insert(holders, pg) end
    for _, h in ipairs(holders) do
        pcall(function()
            for _, g in ipairs(h:GetChildren()) do
                if not rootCache and g:IsA("ScreenGui") and g.Name ~= "WM_FOV" then
                    for _, d in ipairs(g:GetDescendants()) do
                        if d:IsA("TextLabel") and d.Text == "Aim enabled" then rootCache = g; break end
                    end
                end
            end
        end)
        if rootCache then return rootCache end
    end
    return nil
end

-- mobile renders the WindUI window at a smaller pixel size than desktop, so the
-- fixed-pixel thresholds below (tuned on a desktop window) miss real rows/switches.
-- scale every threshold against the actual window width instead of a hardcoded px value.
-- FILL: if rows/checkboxes still don't catch on your phone, "Scan UI (dump)" on it,
-- check the PIN/ROW/KNOB tags in the clipboard dump, and adjust REF_WIDTH to match
-- what AbsoluteSize.X the dump shows for your window frame.
local REF_WIDTH = 600
local function scaleFactor()
    local main = Window.UIElements and Window.UIElements.Main
    local w = main and main.AbsoluteSize and main.AbsoluteSize.X
    if not w or w <= 0 then return 1 end
    return math.clamp(w / REF_WIDTH, 0.5, 1.3)
end

-- returns color, transparency, kind ("Image" = sprite, "Background" = plain frame)
local function surface(o)
    if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then
        return o.ImageColor3, o.ImageTransparency, "Image"
    elseif o:IsA("Frame") or o:IsA("TextButton") or o:IsA("ImageLabel") or o:IsA("ImageButton") or o:IsA("CanvasGroup") then
        return o.BackgroundColor3, o.BackgroundTransparency, "Background"
    end
end

local function setAlpha(o, kind, a)
    if kind == "Image" then o.ImageTransparency = a else o.BackgroundTransparency = a end
end

-- visible layers of an object: sprite image and/or plain background
local function layerProps(o)
    local props = {}
    local isImg = o:IsA("ImageLabel") or o:IsA("ImageButton")
    if isImg and o.Image ~= "" and o.ImageTransparency < 1 then table.insert(props, "ImageTransparency") end
    if (isImg or o:IsA("Frame") or o:IsA("TextButton") or o:IsA("CanvasGroup")) and o.BackgroundTransparency < 1 then
        table.insert(props, "BackgroundTransparency")
    end
    return props
end

-- hover "shine": WindUI fades in a bright full-width layer (white UIGradient) when the
-- cursor is over a row/button. We find those layers and hold them at fully transparent.
local killed = setmetatable({}, {__mode = "k"})

local function isShine(o)
    local col = surface(o)
    if not col then return false end
    if math.min(col.R, col.G, col.B) < 0.7 then return false end -- must be bright/white
    if o.AbsoluteSize.X < 100 * scaleFactor() then return false end -- skip thumbs, icons, check glyphs
    local nm = o.Name:lower()
    local named = nm:find("hover", 1, true) or nm:find("highlight", 1, true)
        or nm:find("shine", 1, true) or nm:find("glow", 1, true) or nm:find("sheen", 1, true)
    return (o:FindFirstChildOfClass("UIGradient") ~= nil) or (named ~= nil)
end

local function killShine(o)
    if killed[o] then return end
    killed[o] = true
    local props = {}
    if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then table.insert(props, "ImageTransparency") end
    table.insert(props, "BackgroundTransparency")
    for _, prop in ipairs(props) do
        o:SetAttribute("WM_want_" .. prop, 1)
        pcall(function() o[prop] = 1 end)
        connect(o:GetPropertyChangedSignal(prop), function()
            if o[prop] ~= 1 then o[prop] = 1 end
        end)
    end
end

-- registry of everything we control: stays valid even at alpha 0 / 1
-- (an object at transparency 1 can't be re-discovered by scanning, so we remember it)
local pinned = setmetatable({}, {__mode = "k"})

local function pinValue(rec)
    if rec.fixed then return rec.fixed end
    return math.min(rec.cap, ROW_ALPHA * rec.mult)
end

local function applyPin(o, rec)
    local a = pinValue(rec)
    for prop in pairs(rec.props) do
        o:SetAttribute("WM_want_" .. prop, a)
        if math.abs(o[prop] - a) > 0.005 then o[prop] = a end
    end
end

-- keeps our alpha even if WindUI re-tints the object (hover, theme, tab switch)
local function pin(o, mult, cap, fixed)
    if killed[o] then return end
    local rec = pinned[o]
    if not rec then
        rec = {props = {}, mult = mult, cap = cap or 1, hooked = {}}
        pinned[o] = rec
    end
    rec.mult, rec.cap = mult, cap or 1
    if fixed then rec.fixed = fixed end
    for _, prop in ipairs(layerProps(o)) do
        rec.props[prop] = true
        if not rec.hooked[prop] then
            rec.hooked[prop] = true
            connect(o:GetPropertyChangedSignal(prop), function()
                local want = o:GetAttribute("WM_want_" .. prop)
                if want and math.abs(o[prop] - want) > 0.005 then o[prop] = want end
            end)
        end
    end
    o:SetAttribute("WM_pinned", true)
    applyPin(o, rec)
end

local function refreshPinned()
    for o, rec in pairs(pinned) do
        if o.Parent then pcall(applyPin, o, rec) end
    end
end

-- row = any row-sized visible surface inside a tab's scroll area (no color test:
-- WindUI sprites are often tinted white/black with their own transparency)
local function isRow(o)
    if #layerProps(o) == 0 then return false end
    local s = scaleFactor()
    local sz = o.AbsoluteSize
    if sz.Y < 24 * s or sz.Y > 200 or sz.X < 200 * s then return false end
    local sf = o:FindFirstAncestorOfClass("ScrollingFrame")
    if not sf then return false end
    local w = sf.AbsoluteSize.X
    return w >= 260 * s and sz.X >= w * 0.6
end

local function hasRowAncestor(o)
    local p = o.Parent
    for _ = 1, 5 do
        if not p then return false end
        if p:GetAttribute("WM_isrow") then return true end
        p = p.Parent
    end
    return false
end

-- off, released from the pin registry, and a checkbox-candidate by size alone would
-- re-catch it on the next scan, so isCheckbox refuses anything already claimed as a knob
local function isCheckbox(o)
    if o:GetAttribute("WM_knob") then return false end
    if o:IsA("TextLabel") or o:IsA("TextBox") then return false end
    local col, tr = surface(o)
    if not col or tr >= 1 then return false end
    local s = scaleFactor()
    local sz = o.AbsoluteSize
    if sz.X < 16 * s or sz.X > 48 * s or math.abs(sz.X - sz.Y) > 4 * s then return false end
    if math.min(col.R, col.G, col.B) > 0.85 then return false end -- white check glyph / thumb
    return hasRowAncestor(o)
end

local function rowHasNumber(row)
    for _, d in ipairs(row:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextBox")) and d.Text:match("^%s*%-?%d+%.?%d*%s*$") then
            return true
        end
    end
    return false
end

-- prettier sliders: thicker rounded track, gradient fill, bigger round thumb with accent ring
-- slider transparency (0 = solid, 1 = invisible): glassy thumb + track, fill stays readable
local SLIDER_THUMB_A = 0.35
local SLIDER_TRACK_A = 0.75
local SLIDER_FILL_A = 0.1

local function holdThickness(o, thickness)
    local function fix()
        local sz = o.Size
        if sz.Y.Scale == 0 and sz.Y.Offset ~= thickness then
            o.Size = UDim2.new(sz.X.Scale, sz.X.Offset, 0, thickness)
        end
    end
    fix()
    connect(o:GetPropertyChangedSignal("Size"), fix)
end

local function holdSize(o, w, h)
    local function fix()
        local sz = o.Size
        if sz.X.Scale == 0 and sz.Y.Scale == 0 and (sz.X.Offset ~= w or sz.Y.Offset ~= h) then
            o.Size = UDim2.fromOffset(w, h)
        end
    end
    fix()
    connect(o:GetPropertyChangedSignal("Size"), fix)
end

local function roundOff(o)
    local cr = o:FindFirstChildOfClass("UICorner")
    if not cr then cr = Instance.new("UICorner"); cr.Parent = o end
    cr.CornerRadius = UDim.new(1, 0)
end

local KNOB_SCALE = 0.7 -- knob diameter as a fraction of the switch track height

local WHITE = Color3.new(1, 1, 1)

local function holdProp(o, prop, value)
    local function fix()
        if o[prop] ~= value then o[prop] = value end
    end
    pcall(fix)
    connect(o:GetPropertyChangedSignal(prop), function() pcall(fix) end)
end

-- switch knob: one clean white circle (sprite + stray layers hidden), a bit smaller than the track
local function isSwitchTrack(o)
    if o:IsA("TextLabel") or o:IsA("TextBox") then return false end
    if not (o:IsA("Frame") or o:IsA("ImageLabel") or o:IsA("ImageButton") or o:IsA("TextButton")) then return false end
    local s = scaleFactor()
    local sz = o.AbsoluteSize
    if sz.X < 30 * s or sz.X > 72 * 1.3 or sz.Y < 16 * s or sz.Y > 38 * 1.3 then return false end
    local ar = sz.X / sz.Y
    if ar < 1.4 or ar > 3.4 then return false end
    return hasRowAncestor(o)
end

-- knob pick: no color filter. an off-state knob is often the same gray as the
-- track itself, so "brightest big square" misses it. size + "narrower than the
-- track" is enough to separate the knob from the track/fill layers underneath it.
local function styleKnob(track)
    local pool = track:GetDescendants()
    if #pool == 0 and track.Parent then pool = track.Parent:GetDescendants() end
    local tw = track.AbsoluteSize.X
    local cands = {}
    for _, k in ipairs(pool) do
        if k ~= track and k:IsA("GuiObject") and not k:IsA("TextLabel") and not k:IsA("TextBox") and not killed[k] then
            local ks = k.AbsoluteSize
            if ks.X >= 8 and ks.X <= 46 and ks.Y >= 8 and ks.Y <= 46 and ks.X < tw * 0.9 then
                table.insert(cands, k)
            end
        end
    end
    if #cands == 0 then return false end

    table.sort(cands, function(a, b) return a.AbsoluteSize.X * a.AbsoluteSize.Y > b.AbsoluteSize.X * b.AbsoluteSize.Y end)
    local knob = cands[1]
    for i = 2, #cands do pcall(killShine, cands[i]) end

    -- pull out of the pin registry (and clear any stale pin attrs) so row-alpha
    -- scans never grey it out again, on or off
    pinned[knob] = nil
    knob:SetAttribute("WM_knob", true)
    knob:SetAttribute("WM_want_BackgroundTransparency", nil)
    knob:SetAttribute("WM_want_ImageTransparency", nil)

    if (knob:IsA("ImageLabel") or knob:IsA("ImageButton")) and knob.Image ~= "" then
        holdProp(knob, "ImageTransparency", 1)
    end
    holdProp(knob, "BackgroundColor3", WHITE)
    holdProp(knob, "BackgroundTransparency", 0)

    local cr = knob:FindFirstChildOfClass("UICorner")
    if not cr then cr = Instance.new("UICorner"); cr.Parent = knob end
    cr.CornerRadius = UDim.new(1, 0)

    local d = math.max(12, math.floor(track.AbsoluteSize.Y * KNOB_SCALE + 0.5))
    local want = UDim2.fromOffset(d, d)
    local function fixSize() if knob.Size ~= want then knob.Size = want end end
    fixSize()
    connect(knob:GetPropertyChangedSignal("Size"), fixSize)

    -- ring/gradient layers off instead of killed (killShine would also fight our
    -- own BackgroundTransparency=0 on the knob itself if they share an ancestor check)
    for _, c in ipairs(knob:GetDescendants()) do
        if c:IsA("UIStroke") or c:IsA("UIGradient") then
            holdProp(c, "Enabled", false)
        elseif c:IsA("GuiObject") and not c:IsA("TextLabel") and not c:IsA("TextBox") then
            pcall(killShine, c)
        end
    end
    return true
end

local function styleSlider(row)
    local thumbFound = false
    for _, d in ipairs(row:GetDescendants()) do
        if d:IsA("GuiObject") and not d:IsA("TextLabel") and not d:IsA("TextBox") and not d:GetAttribute("WM_sl") then
            local col, tr = surface(d)
            if col and tr < 1 then
                local sz = d.AbsoluteSize
                local mn = math.min(col.R, col.G, col.B)
                if mn > 0.85 and sz.X >= 10 and sz.X <= 40 and sz.Y >= 10 and sz.Y <= 40 then
                    -- thumb: left native (our edits caused texture glitches)
                    d:SetAttribute("WM_sl", true)
                    pcall(pin, d, 0, 1, SLIDER_THUMB_A)
                    thumbFound = true
                elseif sz.Y <= 10 and sz.X >= 4 then
                    -- track or fill
                    d:SetAttribute("WM_sl", true)
                    roundOff(d)
                    holdThickness(d, 6)
                    local isFill = col.B > 0.55 and (col.B - col.R) > 0.3
                    pcall(pin, d, 0, 1, isFill and SLIDER_FILL_A or SLIDER_TRACK_A)
                    if isFill then
                        local g = Instance.new("UIGradient")
                        g.Name = "WM_tg"
                        g.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(135, 190, 255))
                        g.Parent = d
                    end
                end
            end
        end
    end
    if thumbFound then row:SetAttribute("WM_slider", true) end
end

-- checkbox look: round, accent ring, soft cool gradient (works for both checked/unchecked tints)
local function styleCheckbox(o)
    if o:GetAttribute("WM_ck") then return end
    o:SetAttribute("WM_ck", true)
    local cr = o:FindFirstChildOfClass("UICorner")
    if not cr then cr = Instance.new("UICorner"); cr.Parent = o end
    cr.CornerRadius = UDim.new(1, 0)

    local st = Instance.new("UIStroke")
    st.Name = "WM_ck_st"
    st.Color = ACCENT
    st.Thickness = 1.5
    st.Transparency = 0.2
    st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    st.Parent = o

    local g = Instance.new("UIGradient")
    g.Name = "WM_ck_g"
    g.Rotation = 45
    g.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 222, 255))
    g.Parent = o
end

local function scanUI(dump)
    local root = getRoot()
    if not root then return 0, 0, "no root" end
    local nRow, nChk = 0, 0
    local lines = dump and {} or nil
    local all = root:GetDescendants()

    -- pass 0: hover shine layers -> force fully transparent
    for _, o in ipairs(all) do
        if o:IsA("GuiObject") and not killed[o] then
            local ok, hit = pcall(isShine, o)
            if ok and hit then
                pinned[o] = nil
                pcall(killShine, o)
            end
        end
    end

    -- pass 1: rows
    for _, o in ipairs(all) do
        if o:IsA("GuiObject") and not killed[o] then
            local ok, hit = pcall(isRow, o)
            if ok and hit then
                nRow = nRow + 1
                o:SetAttribute("WM_isrow", true)
                pcall(pin, o, 1, 1)
                -- inner layers of the row (second sprite, fill, canvas group bg) at nearly full size
                local rs = o.AbsoluteSize
                for _, d in ipairs(o:GetDescendants()) do
                    if d:IsA("GuiObject") and not killed[d] and not d:IsA("TextLabel") and not d:IsA("TextBox") then
                        local ds = d.AbsoluteSize
                        if ds.X >= rs.X * 0.5 and ds.Y >= rs.Y * 0.5 then pcall(pin, d, 1, 1) end
                    end
                end
                if not o:GetAttribute("WM_slider") then
                    pcall(function() if rowHasNumber(o) then styleSlider(o) end end)
                end
            end
        end
    end

    -- pass 2: switch knobs (must run before checkboxes: tags the knob with
    -- WM_knob so the checkbox pass below refuses to re-claim it)
    for _, o in ipairs(all) do
        if o:IsA("GuiObject") and not o:GetAttribute("WM_sw") then
            local ok, hit = pcall(isSwitchTrack, o)
            if ok and hit then
                local ok2, done = pcall(styleKnob, o)
                if ok2 and done then o:SetAttribute("WM_sw", true) end
            end
        end
    end

    -- pass 3: checkboxes inside rows
    for _, o in ipairs(all) do
        if o:IsA("GuiObject") and not o:GetAttribute("WM_isrow") then
            local ok, hit = pcall(isCheckbox, o)
            if ok and hit then
                nChk = nChk + 1
                pcall(pin, o, CHECK_FOLLOW, 0.9)
            end
        end
    end

    if lines then
        for _, o in ipairs(all) do
            if #lines >= 160 then break end
            if o:IsA("GuiObject") then
                local col, tr = surface(o)
                local sz = o.AbsoluteSize
                if col and sz.X >= 14 and tr < 1 then
                    local tag = killed[o] and "SHINE" or o:GetAttribute("WM_isrow") and "ROW" or o:GetAttribute("WM_knob") and "KNOB" or (o:GetAttribute("WM_pinned") and "PIN" or "-")
                    table.insert(lines, string.format("%s|%s|%s|rgb(%.0f,%.0f,%.0f)|a=%.2f|%.0fx%.0f|%s",
                        tag, o.ClassName, o.Name, col.R * 255, col.G * 255, col.B * 255, tr,
                        sz.X, sz.Y, o.Parent and o.Parent.Name or "?"))
                end
            end
        end
    end
    return nRow, nChk, lines and table.concat(lines, "\n") or nil
end

local function applyRowAlpha()
    refreshPinned()
    scanUI(false)
end

-- WindUI re-tints on theme/tab changes, so re-apply lightly
task.spawn(function()
    while rowAlive do
        pcall(applyRowAlpha)
        task.wait(1)
    end
end)

